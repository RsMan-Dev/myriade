+/// PROBE (not committed): `PAR_ONLY=a,b` lets only the named systems use the pool (unset: all; empty string: none).
+pub fn par_on(name: &str) -> bool {
+    static SET: std::sync::OnceLock<Option<Vec<String>>> = std::sync::OnceLock::new();
+    SET.get_or_init(|| std::env::var("PAR_ONLY").ok().map(|v| v.split(',').map(str::to_string).collect())).as_ref().is_none_or(|l| l.iter().any(|x| x == name))
+}
+
+/// PROBE: `SORT=a,b` puts the lists that parallel systems fill through `ParallelCommands` in entity order after the sync point:
+/// `landed`, `left_ground` (events), `damage` (the queue).
+fn probe_sort_queues(mut ev: ResMut<crate::goals::Events>, mut q: ResMut<DamageQueue>) {
+    static SET: std::sync::OnceLock<Vec<String>> = std::sync::OnceLock::new();
+    let set = SET.get_or_init(|| std::env::var("SORT").map(|v| v.split(',').map(str::to_string).collect()).unwrap_or_default());
+    if set.iter().any(|x| x == "landed") {
+        ev.landed.probe_sort();
+    }
+    if set.iter().any(|x| x == "left_ground") {
+        ev.left_ground.probe_sort();
+    }
+    if set.iter().any(|x| x == "damage") {
+        q.0.sort_by_key(|h| h.target);
+    }
+}
+
+static PROBE_REMOVE: std::sync::Mutex<Vec<Entity>> = std::sync::Mutex::new(Vec::new());
+/// PROBE: `SORTCMD=1`: travel's `remove::<Moving>` go through a list sorted by entity, applied by an ordinary `Commands`.
+fn probe_sortcmd() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("SORTCMD").is_some())
+}
+
+static PROBE_PUSH: std::sync::Mutex<Vec<(Entity, Entity, f64, f64, bool)>> = std::sync::Mutex::new(Vec::new());
+static PROBE_MOVING: std::sync::Mutex<Vec<Entity>> = std::sync::Mutex::new(Vec::new());
